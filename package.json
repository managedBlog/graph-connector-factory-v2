{
  "name": "graph-connector-factory",
  "version": "1.0.0-alpha.1",
  "description": "Unified MCP server for Graph Connector Factory — research, generate, and deploy Power Platform custom connectors from Microsoft Graph API.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "cross-env MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.5.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "cross-env": "^10.1.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
