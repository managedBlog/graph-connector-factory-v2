    "/api/testing/generate-plan": {
      "post": {
        "operationId": "testing_generateMultiPlan",
        "summary": "Generate CUA test plan",
        "description": "Generate a structured test plan for one or more deployed connectors. Accepts a JSON string of connector specs (each with displayName, scope, and baseName) and returns a test plan for Computer Use Agent execution.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "environmentId",
                "connectorsJson"
              ],
              "properties": {
                "environmentId": {
                  "type": "string",
                  "description": "Target Power Platform environment ID (GUID).",
                  "x-ms-summary": "Environment ID"
                },
                "environmentName": {
                  "type": "string",
                  "description": "Display name of the target Power Platform environment. Included in the test plan so the CUA can verify it is in the correct environment.",
                  "x-ms-summary": "Environment Name"
                },
                "connectorsJson": {
                  "type": "string",
                  "description": "JSON string array of connector specs. Each item: {\u0022displayName\u0022:\u0022...\u0022,\u0022scope\u0022:\u0022all|crud\u0022,\u0022baseName\u0022:\u0022...\u0022}. For selected ops use {\u0022scope\u0022:[\u0022op1\u0022,\u0022op2\u0022]}.",
                  "x-ms-summary": "Connectors JSON"
                },
                "variables": {
                  "type": "string",
                  "description": "Optional JSON string of key-value variables for test data (e.g. {\u0022tenantDomain\u0022:\u0022contoso.com\u0022}).",
                  "x-ms-summary": "Variables JSON",
                  "x-ms-visibility": "advanced"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Test plan generated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "totalConnectors": {
                  "type": "integer",
                  "description": "Number of connectors in the test plan.",
                  "x-ms-summary": "Total Connectors"
                },
                "totalOperations": {
                  "type": "integer",
                  "description": "Total operations to test.",
                  "x-ms-summary": "Total Operations"
                },
                "testPlanMarkdown": {
                  "type": "string",
                  "description": "Human-readable test plan in markdown format. Pass directly to the CUA agent as instructions.",
                  "x-ms-summary": "Test Plan (Markdown)"
                }
              }
            }
          }
        }
      }
    },
