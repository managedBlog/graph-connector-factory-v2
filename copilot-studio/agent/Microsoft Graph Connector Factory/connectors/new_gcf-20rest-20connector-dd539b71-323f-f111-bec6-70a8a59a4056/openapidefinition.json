{
  "swagger": "2.0",
  "info": {
    "title": "GCF REST Connector",
    "description": "Unified custom connector for Graph Connector Factory. Exposes research operations (list Graph API operations, generate connectors, manage session context) and deployment operations (deploy connectors, check names, list environments). All operations require OAuth authentication.",
    "version": "1.1",
    "contact": {
      "name": "Graph Connector Factory",
      "url": "https://github.com/managedBlog/graph-connector-factory-v2"
    }
  },
  "host": "5qgmmvlb-3001.use.devtunnels.ms",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/graph/connector/batch": {
      "post": {
        "operationId": "graph_batchGenerate",
        "summary": "Batch generate custom connectors",
        "description": "Generate Power Platform custom connector Swagger files for multiple connector groups in a single call. Accepts a JSON string of groups (each with baseName and ops), generates each connector, publishes to Gist, and returns results as a JSON string for Parse value node consumption.",
        "x-ms-visibility": "important",
        "x-ms-api-timeout": 120,
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "groupsJson"
              ],
              "properties": {
                "groupsJson": {
                  "type": "string",
                  "description": "JSON string containing an array of connector groups. Each group has baseName (string) and ops (comma-separated operation IDs string). Example: [{\u0022baseName\u0022:\u0022Users\u0022,\u0022ops\u0022:\u0022users.list,users.get\u0022},{\u0022baseName\u0022:\u0022Groups\u0022,\u0022ops\u0022:\u0022groups.list\u0022}]",
                  "x-ms-summary": "Groups JSON"
                },
                "version": {
                  "type": "string",
                  "default": "v1.0",
                  "enum": [
                    "v1.0",
                    "beta"
                  ],
                  "description": "Graph API version",
                  "x-ms-summary": "API Version",
                  "x-ms-visibility": "advanced"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "groupCount": {
                  "type": "integer",
                  "description": "Total number of groups processed",
                  "x-ms-summary": "Group Count"
                },
                "successCount": {
                  "type": "integer",
                  "description": "Number of groups that generated successfully",
                  "x-ms-summary": "Success Count"
                },
                "resultsJson": {
                  "type": "string",
                  "description": "JSON string containing per-group results array. Each item has baseName, gistUrl, swaggerRawUrl, totalOperations, status, warnings, and optional error. Use Parse value node with sample JSON to convert to typed Table.",
                  "x-ms-summary": "Results JSON"
                }
              }
            }
          }
        }
      }
    },
    "/api/graph/session/context": {
      "get": {
        "operationId": "graph_getSessionContext",
        "summary": "Get session context",
        "description": "Returns the full session context including explored endpoints and design decisions captured via graph_setDesignContext. Flat response: all endpoint tracking fields plus all design context fields merged at top level.",
        "x-ms-visibility": "important",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "endpoints": {
                  "type": "array",
                  "x-ms-summary": "Endpoints",
                  "items": {
                    "type": "string"
                  }
                },
                "endpointCount": {
                  "type": "integer",
                  "x-ms-summary": "Endpoint Count"
                },
                "latestEndpoint": {
                  "type": "string",
                  "x-ms-summary": "Latest Endpoint",
                  "x-nullable": true
                },
                "endpointPath": {
                  "type": "string",
                  "x-ms-summary": "Endpoint Path",
                  "x-nullable": true,
                  "description": "Comma-separated endpoint paths from design context."
                },
                "hasDesignContext": {
                  "type": "boolean",
                  "x-ms-summary": "Has Design Context",
                  "description": "True if graph_setDesignContext was called during this session."
                },
                "authType": {
                  "type": "string",
                  "x-ms-summary": "Auth Type",
                  "x-nullable": true,
                  "description": "Desired auth type: NoAuth, OAuthAAD, or FederatedIdentity."
                },
                "connectorCount": {
                  "type": "integer",
                  "x-ms-summary": "Connector Count",
                  "x-nullable": true
                },
                "maxOperations": {
                  "type": "integer",
                  "x-ms-summary": "Max Operations Per Connector",
                  "description": "Maximum operations allowed per connector (from server config)."
                },
                "appRegistrationStrategy": {
                  "type": "string",
                  "x-ms-summary": "App Registration Strategy",
                  "x-nullable": true
                },
                "environmentId": {
                  "type": "string",
                  "x-ms-summary": "Environment ID",
                  "x-nullable": true
                },
                "baseName": {
                  "type": "string",
                  "x-ms-summary": "Base Name",
                  "x-nullable": true
                },
                "baseNameSource": {
                  "type": "string",
                  "x-ms-summary": "Base Name Source",
                  "x-nullable": true,
                  "enum": [
                    "ai",
                    "generated"
                  ],
                  "description": "\u0027ai\u0027 = name provided by the AI during research, \u0027generated\u0027 = auto-generated from endpoint paths."
                },
                "targetVersion": {
                  "type": "string",
                  "x-ms-summary": "Target Version",
                  "x-nullable": true
                },
                "notes": {
                  "type": "string",
                  "x-ms-summary": "Notes",
                  "x-nullable": true
                },
                "connectorGroupsJson": {
                  "type": "string",
                  "x-ms-summary": "Connector Groups JSON",
                  "description": "Deprecated \u2014 kept for backward compatibility. Always empty string. Use group1Json, group2Json, group3Json instead."
                },
                "group1Json": {
                  "type": "string",
                  "x-ms-summary": "Group 1 JSON",
                  "description": "JSON-serialized connector group 1 object with baseName and operations array. Empty string if fewer than 1 group."
                },
                "group2Json": {
                  "type": "string",
                  "x-ms-summary": "Group 2 JSON",
                  "description": "JSON-serialized connector group 2 object. Empty string if fewer than 2 groups."
                },
                "group3Json": {
                  "type": "string",
                  "x-ms-summary": "Group 3 JSON",
                  "description": "JSON-serialized connector group 3 object. Empty string if fewer than 3 groups."
                },
                "runId": {
                  "type": "string",
                  "x-ms-summary": "Run ID",
                  "x-nullable": true,
                  "description": "Current active run ID for this session context."
                }
              }
            }
          }
        }
      }
    },
    "/api/graph/deploy": {
      "post": {
        "operationId": "graph_deployPipeline",
        "summary": "Deploy connector pipeline (async)",
        "description": "Start an asynchronous deploy of a Power Platform custom connector. Returns a jobId immediately. Poll graph_deployStatus with the jobId to track progress and get results.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "baseName",
                "swaggerUrl",
                "environmentId",
                "authType"
              ],
              "properties": {
                "baseName": {
                  "type": "string",
                  "description": "Validated connector display name. Used as-is for the connector and app registration.",
                  "x-ms-summary": "Base Name"
                },
                "environmentId": {
                  "type": "string",
                  "description": "Target Power Platform environment ID (GUID).",
                  "x-ms-summary": "Environment ID"
                },
                "authType": {
                  "type": "string",
                  "description": "Auth type for the deployed connector: NoAuth, OAuthAAD, or FederatedIdentity.",
                  "x-ms-summary": "Auth Type"
                },
                "swaggerUrl": {
                  "type": "string",
                  "description": "URL to the generated Swagger definition (from graph_generateConnector Gist URL).",
                  "x-ms-summary": "Swagger URL"
                },
                "apiDefinition": {
                  "type": "string",
                  "description": "Inline Swagger JSON string. Use this OR swaggerUrl, not both.",
                  "x-ms-summary": "API Definition",
                  "x-ms-visibility": "advanced"
                },
                "runId": {
                  "type": "string",
                  "description": "Optional run ID used for strict isolation.",
                  "x-ms-summary": "Run ID",
                  "x-ms-visibility": "advanced"
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Job accepted \u2014 poll graph_deployStatus for result",
            "schema": {
              "$ref": "#/definitions/DeployJobResponse"
            }
          }
        }
      }
    },
    "/api/graph/deploy/status": {
      "get": {
        "operationId": "graph_deployStatus",
        "summary": "Poll deploy job status",
        "description": "Long-polls a deploy or batch-deploy job. Returns the current status and, when complete, the full result. If the job is still running, holds the request up to 25 seconds before returning the latest progress. Topic should loop on this until status is success, partial, or failed.",
        "x-ms-visibility": "important",
        "x-ms-api-timeout": 30,
        "parameters": [
          {
            "name": "jobId",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "The deploy job ID returned by graph_deployPipeline or graph_batchDeploy.",
            "x-ms-summary": "Job ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Job status and result (when complete)",
            "schema": {
              "$ref": "#/definitions/DeployJobResponse"
            }
          }
        }
      }
    },
